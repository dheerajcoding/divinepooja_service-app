# Site / branding
REACT_APP_BRAND_NAME=Divine Pooja Services
REACT_APP_BRAND_SHORT=Divine Pooja
REACT_APP_BRAND_TAGLINE=Authentic Vedic poojas at your doorstep, performed by experienced pandits.
REACT_APP_SITE_URL=https://your-domain.com

# Contact details (used in Navbar, Footer, Contact page, WhatsApp links)
REACT_APP_PHONE=+91 98765 43210
REACT_APP_PHONE_INTL=+919876543210
REACT_APP_WHATSAPP=919876543210
REACT_APP_EMAIL=info@your-domain.com
REACT_APP_ADDRESS_1=123 Temple Street
REACT_APP_ADDRESS_2=New Delhi, India
REACT_APP_HOURS=Mon - Sun: 6:00 AM - 9:00 PM

# Optional social profiles
REACT_APP_FACEBOOK=
REACT_APP_INSTAGRAM=

# Optional: a Formspree / Web3Forms / Getform endpoint that accepts JSON POSTs.
# Inquiries are also sent via WhatsApp; this just gives you an email/db copy.
REACT_APP_INQUIRY_ENDPOINT=

# Admin panel password (used only when Firebase is NOT configured below)
REACT_APP_ADMIN_PASSWORD=admin123

# ─── Firebase (recommended) ────────────────────────────────────────────────
# Copy these from Firebase Console → Project settings → "Your apps" → Web app.
# When all 6 values are present, the site uses Firestore for live data and
# Firebase Auth for the admin login (the password above is then ignored).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
